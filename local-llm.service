[Unit]
Description=Local LLM Server

[Service]
Type=exec
WorkingDirectory=%h/Documents/local-llm

Environment=CUDA_SCALE_LAUNCH_QUEUES=4x
Environment=HOST=0.0.0.0
Environment=PORT=10000
Environment=CONFIG=%h/Documents/local-llm/model-config.ini

ExecStart=/usr/local/bin/llama-server --host ${HOST} --port ${PORT} --models-preset ${CONFIG}

Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
